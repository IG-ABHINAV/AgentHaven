{
  "name": "agenthaven",
  "version": "0.6.0",
  "description": "One local work board for AI agents from every vendor: claims with leases, dependencies, review gates, progress, cost and metrics, via MCP, a shared WORKBOARD.md or HTTP.",
  "license": "MIT",
  "author": "laaielichter",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "agent-coordination",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "task-board",
    "electron"
  ],
  "homepage": "https://laaielichter.github.io/AgentHaven/",
  "repository": "github:laaielichter/AgentHaven",
  "main": "desktop/main.js",
  "bin": {
    "agenthaven": "bin/agenthaven.js"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node --check scripts/prefetch-electron.js && node --check scripts/claude-commands.js && node --check src/store.js && node --check src/workboard.js && node --check src/dream.js && node --check src/guard.js && node --check src/git.js && node --check src/checks.js && node --check src/prompts.js && node --check src/hooks.js && node --check src/mcp.js && node --check src/server.js && node --check src/connect.js && node --check src/notify.js && node --check bin/agenthaven.js && node --check desktop/main.js && node --check desktop/updater.js && node --check desktop/preload.js && node --check ui/app.js",
    "serve": "node bin/agenthaven.js serve",
    "mcp": "node bin/agenthaven.js mcp",
    "app": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.laaielichter.agenthaven",
    "productName": "AgentHaven",
    "asar": false,
    "files": [
      "bin/**",
      "src/**",
      "ui/**",
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentHaven"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "laaielichter",
        "repo": "AgentHaven"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
